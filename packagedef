////////////////////////////////////////////////////////////
// Описание пакета changelog-reader для сборки и установки
//

Описание.Имя("changelog-reader")
		.Версия("0.1.2")
		.Автор("Segate-ekb")
		.Описание("Чтение журнала изменений в формате Keep a Changelog: релизы и их разделы, блок «Не выпущено», заметки к версии готовым markdown, поиск и выборка по семантическим версиям и диапазонам semver")
		.ВерсияСреды("2.0.0")

		.ЗависитОт("semver", "1.1.1")
		.ЗависитОт("strings", "0.5.0")

		.РазработкаЗависитОт("asserts", "1.6.0")
		.РазработкаЗависитОт("oneunit", "0.9.0")

		.ОпределяетМодуль("ЖурналыПеремен", "src/Модули/ЖурналыПеремен.os")

		.ОпределяетКласс("ЖурналПеремен", "src/Классы/ЖурналПеремен.os")
		.ОпределяетКласс("РелизЖурнала", "src/Классы/РелизЖурнала.os")

		.ВключитьФайл("packagedef")
		.ВключитьФайл("src")
		.ВключитьФайл("README.md")
		.ВключитьФайл("CHANGELOG.md")
		.ВключитьФайл("LICENSE");
