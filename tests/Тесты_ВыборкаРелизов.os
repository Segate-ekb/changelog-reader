#Использовать "../"
#Использовать asserts

// Выборка релизов: порядок, поиск по версии и диапазоны semver.

&Тест
Процедура РелизыУпорядоченыПоУбываниюСемантическойВерсии() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста(ЖурналВперемешку());

	Версии_ = Журнал.ВерсииРелизов();

	Ожидаем.Что(Версии_.Количество()).Равно(4);
	// строковая сортировка поставила бы «1.2.0» выше «1.10.0» — порядок задаёт semver
	Ожидаем.Что(Версии_[0], "самая свежая версия первой").Равно("1.10.0");
	Ожидаем.Что(Версии_[1]).Равно("1.2.0");
	Ожидаем.Что(Версии_[2]).Равно("1.0.0");
	Ожидаем.Что(Версии_[3]).Равно("1.0.0-rc.1");

КонецПроцедуры

&Тест
Процедура ПоследнийРелизЭтоМаксимальнаяВерсияАНеПерваяСтрокаФайла() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста(ЖурналВперемешку());

	Ожидаем.Что(Журнал.ПоследнийРелиз().Версия()).Равно("1.10.0");
	Ожидаем.Что(Журнал.ПоследнийРелиз().ДатаРелиза()).Равно(Дата(2026, 3, 15));

КонецПроцедуры

&Тест
Процедура РелизНаходитсяПоНеполнойВерсии() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста(ЖурналВперемешку());

	Ожидаем.Что(Журнал.Релиз("1.0").Версия(), "«1.0» — это «1.0.0»").Равно("1.0.0");
	Ожидаем.Что(Журнал.ЕстьВерсия("1.0")).ЭтоИстина();
	Ожидаем.Что(Журнал.ЕстьВерсия("1.0.0")).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПредрелизИРелизРазныеЗаписи() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста(ЖурналВперемешку());

	Ожидаем.Что(Журнал.Релиз("1.0.0-rc.1").Пункты()[0]).Равно("кандидат в релизы");
	Ожидаем.Что(Журнал.Релиз("1.0.0").Пункты()[0], "релиз не подменяется предрелизом")
		.Равно("первый выпуск");

КонецПроцедуры

&Тест
Процедура НесуществующаяВерсияДаётНеопределено() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста(ЖурналВперемешку());

	Ожидаем.Что(Журнал.Релиз("9.9.9")).ЭтоНеопределено();
	Ожидаем.Что(Журнал.ЕстьВерсия("9.9.9")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура МусорВместоВерсииНеРоняетПоиск() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста(ЖурналВперемешку());

	Ожидаем.Что(Журнал.Релиз("совсем не версия")).ЭтоНеопределено();
	Ожидаем.Что(Журнал.Релиз("")).ЭтоНеопределено();
	Ожидаем.Что(Журнал.ЕстьВерсия(Неопределено)).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ДиапазонОтбираетТолькоСвоиРелизы() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста(ЖурналСДвойкой());

	Отобранные = Журнал.РелизыВДиапазоне("^1.0.0");

	Ожидаем.Что(Отобранные.Количество(), "2.0.0 в ^1.0.0 не входит").Равно(2);
	Ожидаем.Что(Отобранные[0].Версия()).Равно("1.10.0");
	Ожидаем.Что(Отобранные[1].Версия()).Равно("1.0.0");

КонецПроцедуры

&Тест
Процедура ДиапазонСВерхнейГраницейРаботает() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста(ЖурналСДвойкой());

	Отобранные = Журнал.РелизыВДиапазоне(">=1.10.0 <3.0.0");

	Ожидаем.Что(Отобранные.Количество()).Равно(2);
	Ожидаем.Что(Отобранные[0].Версия()).Равно("2.0.0");
	Ожидаем.Что(Отобранные[1].Версия()).Равно("1.10.0");

КонецПроцедуры

&Тест
Процедура ПустойИНеразборчивыйДиапазонНичегоНеОтбирают() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста(ЖурналСДвойкой());

	Ожидаем.Что(Журнал.РелизыВДиапазоне("").Количество(),
		"пустой диапазон — это не «все релизы»").Равно(0);
	Ожидаем.Что(Журнал.РелизыВДиапазоне("не диапазон").Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ВыборкиВозвращаютКопииИНеДаютПравитьЖурнал() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста(ЖурналСДвойкой());

	Снимок = Журнал.Релизы();
	Снимок.Очистить();

	Ожидаем.Что(Журнал.Релизы().Количество(), "журнал не изменился").Равно(3);

	Разделы = Журнал.ПоследнийРелиз().ИменаРазделов();
	Разделы.Очистить();
	Ожидаем.Что(Журнал.ПоследнийРелиз().ИменаРазделов().Количество(),
		"разделы релиза не изменились").Равно(1);

КонецПроцедуры

Функция ЖурналВперемешку()

	Строки = Новый Массив();
	Строки.Добавить("# Изменения");
	Строки.Добавить("");
	Строки.Добавить("## [1.2.0] - 2026-02-01");
	Строки.Добавить("- меньше, чем 1.10.0");
	Строки.Добавить("");
	Строки.Добавить("## [1.0.0-rc.1] - 2026-01-10");
	Строки.Добавить("- кандидат в релизы");
	Строки.Добавить("");
	Строки.Добавить("## [1.10.0] - 2026-03-15");
	Строки.Добавить("- больше, чем 1.2.0");
	Строки.Добавить("");
	Строки.Добавить("## [1.0.0] - 2026-01-15");
	Строки.Добавить("- первый выпуск");
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ЖурналСДвойкой()

	Строки = Новый Массив();
	Строки.Добавить("## [2.0.0] - 2026-06-01");
	Строки.Добавить("### Изменено");
	Строки.Добавить("- несовместимо");
	Строки.Добавить("");
	Строки.Добавить("## [1.10.0] - 2026-03-15");
	Строки.Добавить("### Добавлено");
	Строки.Добавить("- ещё одно");
	Строки.Добавить("");
	Строки.Добавить("## [1.0.0] - 2026-01-15");
	Строки.Добавить("### Добавлено");
	Строки.Добавить("- первый выпуск");
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции
