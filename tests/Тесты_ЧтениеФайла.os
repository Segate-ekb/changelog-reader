#Использовать "../"
#Использовать asserts

// Чтение журнала с диска: собственный CHANGELOG.md библиотеки как живая фикстура.

&Тест
Процедура СобственныйЖурналБиблиотекиЧитается() Экспорт

	Журнал = ЖурналыПеремен.ИзФайла(ПутьЖурнала());

	Ожидаем.Что(Журнал.Релизы().Количество(), "релизы найдены").Больше(0);
	Ожидаем.Что(Журнал.ЕстьВерсия(ВерсияПакета()),
		"в журнале описана версия из packagedef: " + ВерсияПакета()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗаметкиКВерсииГодятсяДляРелизаНаGitHub() Экспорт

	Релиз = ЖурналыПеремен.ИзФайла(ПутьЖурнала()).Релиз(ВерсияПакета());

	Ожидаем.Что(Релиз.Текст(), "заметки не пустые").Заполнено();
	Ожидаем.Что(Релиз.Пункты().Количество(), "пункты разобраны").Больше(0);

КонецПроцедуры

&Тест
Процедура ОтсутствующийФайлДаётВнятныйОтказ() Экспорт

	Путь = ОбъединитьПути(КаталогВременныхФайлов(), "нет-такого-журнала-"
		+ Строка(Новый УникальныйИдентификатор) + ".md");

	Текст = "";
	Попытка
		ЖурналыПеремен.ИзФайла(Путь);
	Исключение
		Текст = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Текст, "отказ называет путь").Содержит(Путь);

КонецПроцедуры

&Тест
Процедура ПустойПутьНеЧитаетсяМолча() Экспорт

	Текст = "";
	Попытка
		ЖурналыПеремен.ИзФайла("");
	Исключение
		Текст = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(ЗначениеЗаполнено(Текст), "пустой путь — исключение, а не пустой журнал")
		.ЭтоИстина();

КонецПроцедуры

Функция ПутьЖурнала()
	Возврат ОбъединитьПути(КаталогБиблиотеки(), "CHANGELOG.md");
КонецФункции

Функция КаталогБиблиотеки()
	Возврат Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "..")).ПолноеИмя;
КонецФункции

// Версия берётся из packagedef, а не из константы теста: иначе тест перестал бы ловить
// выпуск, о котором забыли написать в журнале.
Функция ВерсияПакета()

	Чтение = Новый ЧтениеТекста(ОбъединитьПути(КаталогБиблиотеки(), "packagedef"), "UTF-8");
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Начало = СтрНайти(Текст, ".Версия(""");
	Ожидаем.Что(Начало > 0, "в packagedef есть .Версия(...)").ЭтоИстина();

	Остаток = Сред(Текст, Начало + СтрДлина(".Версия("""));
	Возврат Лев(Остаток, СтрНайти(Остаток, """") - 1);

КонецФункции
