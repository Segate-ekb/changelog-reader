#Использовать "../"
#Использовать asserts

// Разбор журнала: заголовки релизов, разделы, пункты, даты и мусор в заголовках.

&Тест
Процедура РелизыЧитаютсяСРазделамиИПунктами() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста(ПримерЖурнала());

	Релиз = Журнал.Релиз("1.2.0");
	Ожидаем.Что(Релиз, "релиз 1.2.0 найден").Заполнено();
	Ожидаем.Что(Релиз.ИменаРазделов().Количество(), "два раздела").Равно(2);
	Ожидаем.Что(Релиз.ИменаРазделов()[0], "порядок разделов — как в файле").Равно("Добавлено");
	Ожидаем.Что(Релиз.Пункты("Добавлено").Количество()).Равно(2);
	Ожидаем.Что(Релиз.Пункты("Добавлено")[0]).Равно("выборка релизов по диапазону semver");
	Ожидаем.Что(Релиз.Пункты("Исправлено")[0]).Равно("дата без тире больше не теряется");

КонецПроцедуры

&Тест
Процедура ПунктыБезИмениРазделаСобираютВсеПункты() Экспорт

	Релиз = ЖурналыПеремен.ИзТекста(ПримерЖурнала()).Релиз("1.2.0");

	Ожидаем.Что(Релиз.Пункты().Количество(), "все пункты релиза").Равно(3);

КонецПроцедуры

&Тест
Процедура ИмяРазделаНечувствительноКРегистру() Экспорт

	Релиз = ЖурналыПеремен.ИзТекста(ПримерЖурнала()).Релиз("1.2.0");

	Ожидаем.Что(Релиз.ЕстьРаздел("добавлено")).ЭтоИстина();
	Ожидаем.Что(Релиз.Пункты("ДОБАВЛЕНО").Количество()).Равно(2);
	Ожидаем.Что(Релиз.ЕстьРаздел("Удалено"), "раздела в релизе нет").ЭтоЛожь();
	Ожидаем.Что(Релиз.Пункты("Удалено").Количество(), "пункты отсутствующего раздела пусты").Равно(0);

КонецПроцедуры

&Тест
Процедура ДатаРелизаЧитаетсяИзЗаголовка() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста(ПримерЖурнала());

	Ожидаем.Что(Журнал.Релиз("1.2.0").ДатаРелиза()).Равно(Дата(2026, 2, 1));
	Ожидаем.Что(Журнал.Релиз("1.10.0").ДатаРелиза()).Равно(Дата(2026, 3, 15));

КонецПроцедуры

&Тест
Процедура ЗаголовокБезДатыДаётПустуюДату() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста(
		"## [0.9.0]" + Символы.ПС
		+ "### Добавлено" + Символы.ПС
		+ "- первый черновик");

	Ожидаем.Что(ЗначениеЗаполнено(Журнал.Релиз("0.9.0").ДатаРелиза()),
		"даты в заголовке нет — дата пустая").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура НеразобраннаяДатаНеРоняетРазбор() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста(
		"## [0.9.0] - когда-нибудь" + Символы.ПС
		+ "- пункт");

	Ожидаем.Что(Журнал.Релизы().Количество(), "релиз прочитан").Равно(1);
	Ожидаем.Что(ЗначениеЗаполнено(Журнал.Релиз("0.9.0").ДатаРелиза()),
		"мусор вместо даты — дата пустая").ЭтоЛожь();
	Ожидаем.Что(Журнал.Релиз("0.9.0").Пункты().Количество(), "пункты не потеряны").Равно(1);

КонецПроцедуры

&Тест
Процедура ЗаголовокБезСкобокТожеРелиз() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста("## 2.0.0 - 2026-04-01" + Символы.ПС + "- пункт");

	Ожидаем.Что(Журнал.Релизы().Количество()).Равно(1);
	Ожидаем.Что(Журнал.ПоследнийРелиз().Версия()).Равно("2.0.0");
	Ожидаем.Что(Журнал.ПоследнийРелиз().ДатаРелиза()).Равно(Дата(2026, 4, 1));

КонецПроцедуры

&Тест
Процедура ПриставкаVСнимается() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста("## [v3.1.0] - 2026-05-05" + Символы.ПС + "- пункт");

	Ожидаем.Что(Журнал.ПоследнийРелиз().Версия(), "версия без приставки").Равно("3.1.0");
	Ожидаем.Что(Журнал.ЕстьВерсия("v3.1.0"), "искать можно и с приставкой").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НеверсионныйЗаголовокРелизомНеСтановится() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста(
		"## [следующий]" + Символы.ПС
		+ "- когда-нибудь" + Символы.ПС
		+ "## [1.0.0] - 2026-01-01" + Символы.ПС
		+ "- первый релиз");

	Ожидаем.Что(Журнал.Релизы().Количество(), "мусорный заголовок не релиз").Равно(1);
	Ожидаем.Что(Журнал.ПоследнийРелиз().Версия()).Равно("1.0.0");

КонецПроцедуры

&Тест
Процедура НеизданноеОтделеноОтРелизов() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста(ПримерЖурнала());

	Ожидаем.Что(Журнал.Неизданное(), "блок «Не выпущено» найден").Заполнено();
	Ожидаем.Что(Журнал.Неизданное().ЭтоНеизданное()).ЭтоИстина();
	Ожидаем.Что(Журнал.Неизданное().Версия(), "версии у него нет").Равно("");
	Ожидаем.Что(Журнал.Неизданное().Пункты()[0]).Равно("ничего пока не накопилось");
	Ожидаем.Что(Журнал.Релизы().Количество(), "в релизы он не попал").Равно(3);

КонецПроцедуры

&Тест
Процедура АнглийскийЗаголовокUnreleasedТожеОпознаётся() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста("## [Unreleased]" + Символы.ПС + "- work in progress");

	Ожидаем.Что(Журнал.Неизданное()).Заполнено();
	Ожидаем.Что(Журнал.Релизы().Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ЗаголовокТретьегоУровняНеОткрываетРелиз() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста(
		"## [1.0.0] - 2026-01-01" + Символы.ПС
		+ "### Добавлено" + Символы.ПС
		+ "- пункт");

	Ожидаем.Что(Журнал.Релизы().Количество(), "«###» — раздел, а не релиз").Равно(1);
	Ожидаем.Что(Журнал.ПоследнийРелиз().ИменаРазделов().Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ТекстРелизаГодитсяКакЗаметкиКРелизу() Экспорт

	Релиз = ЖурналыПеремен.ИзТекста(ПримерЖурнала()).Релиз("1.10.0");

	Ожидаем.Что(Релиз.Текст(), "заголовок релиза в заметки не попадает").Не_().Содержит("## [1.10.0]");
	Ожидаем.Что(Релиз.Текст(), "разделы остаются как есть").Содержит("### Добавлено");
	Ожидаем.Что(СтрНачинаетсяС(Релиз.Текст(), "###"),
		"пустые строки по краям срезаны").ЭтоИстина();
	Ожидаем.Что(Релиз.Текст(), "текст следующего релиза не приезжает").Не_().Содержит("1.2.0");

КонецПроцедуры

&Тест
Процедура ПереводыСтрокWindowsРазбираютсяТакЖе() Экспорт

	Текст = СтрЗаменить(ПримерЖурнала(), Символы.ПС, Символы.ВК + Символы.ПС);

	Журнал = ЖурналыПеремен.ИзТекста(Текст);

	Ожидаем.Что(Журнал.Релизы().Количество()).Равно(3);
	Ожидаем.Что(Журнал.Релиз("1.2.0").Пункты("Добавлено").Количество()).Равно(2);
	Ожидаем.Что(Журнал.Релиз("1.2.0").Пункты("Добавлено")[0],
		"возврат каретки не остался в пункте").Равно("выборка релизов по диапазону semver");

КонецПроцедуры

&Тест
Процедура ПустойЖурналНеПадает() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста("");

	Ожидаем.Что(Журнал.Релизы().Количество()).Равно(0);
	Ожидаем.Что(Журнал.ПоследнийРелиз()).ЭтоНеопределено();
	Ожидаем.Что(Журнал.Неизданное()).ЭтоНеопределено();
	Ожидаем.Что(Журнал.Релиз("1.0.0")).ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура ТекстБезЗаголовковРелизовДаётПустойЖурнал() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста(
		"# Изменения" + Символы.ПС
		+ "Формат основан на Keep a Changelog." + Символы.ПС
		+ "- просто пункт вне релиза");

	Ожидаем.Что(Журнал.Релизы().Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура МаркерыСпискаЗвёздочкойИПлюсомТожеПункты() Экспорт

	Журнал = ЖурналыПеремен.ИзТекста(
		"## [1.0.0] - 2026-01-01" + Символы.ПС
		+ "* звёздочка" + Символы.ПС
		+ "+ плюс" + Символы.ПС
		+ "обычная строка");

	Пункты = Журнал.ПоследнийРелиз().Пункты();
	Ожидаем.Что(Пункты.Количество(), "строка без маркера пунктом не считается").Равно(2);
	Ожидаем.Что(Пункты[0]).Равно("звёздочка");
	Ожидаем.Что(Пункты[1]).Равно("плюс");

КонецПроцедуры

Функция ПримерЖурнала() Экспорт

	Строки = Новый Массив();
	Строки.Добавить("# Изменения");
	Строки.Добавить("");
	Строки.Добавить("## [Не выпущено]");
	Строки.Добавить("");
	Строки.Добавить("- ничего пока не накопилось");
	Строки.Добавить("");
	Строки.Добавить("## [1.10.0] - 2026-03-15");
	Строки.Добавить("");
	Строки.Добавить("### Добавлено");
	Строки.Добавить("");
	Строки.Добавить("- чтение журнала из файла");
	Строки.Добавить("");
	Строки.Добавить("## [1.2.0] - 2026-02-01");
	Строки.Добавить("");
	Строки.Добавить("### Добавлено");
	Строки.Добавить("");
	Строки.Добавить("- выборка релизов по диапазону semver");
	Строки.Добавить("- заметки к релизу готовым markdown");
	Строки.Добавить("");
	Строки.Добавить("### Исправлено");
	Строки.Добавить("");
	Строки.Добавить("- дата без тире больше не теряется");
	Строки.Добавить("");
	Строки.Добавить("## [1.0.0] - 2026-01-15");
	Строки.Добавить("");
	Строки.Добавить("### Добавлено");
	Строки.Добавить("");
	Строки.Добавить("- первый выпуск");
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции
