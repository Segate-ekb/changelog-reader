// Точка входа библиотеки: журнал изменений Keep a Changelog из файла или из текста.

#Область ПрограммныйИнтерфейс

// Читает и разбирает журнал изменений из файла.
//
// Параметры:
//  Путь - Строка - путь к файлу журнала, обычно CHANGELOG.md.
//  Кодировка - Строка - кодировка файла (необязательный, по умолчанию "UTF-8").
//
// Возвращаемое значение:
//  ЖурналПеремен - разобранный журнал.
//
Функция ИзФайла(Знач Путь, Знач Кодировка = "UTF-8") Экспорт

	Значение = СокрЛП(Строка(?(Путь = Неопределено, "", Путь)));
	Если НЕ ЗначениеЗаполнено(Значение) ИЛИ НЕ Новый Файл(Значение).Существует() Тогда
		ВызватьИсключение СтрШаблон("Файл журнала изменений не найден: ""%1""", Значение);
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(Значение, Кодировка);
	Попытка
		Текст = Чтение.Прочитать();
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Чтение.Закрыть();

	Возврат ИзТекста(?(Текст = Неопределено, "", Текст));

КонецФункции

// Разбирает журнал изменений из текста.
//
// Параметры:
//  Текст - Строка - содержимое журнала в формате Keep a Changelog.
//
// Возвращаемое значение:
//  ЖурналПеремен - разобранный журнал; пустой текст даёт журнал без релизов.
//
Функция ИзТекста(Знач Текст) Экспорт
	Возврат Новый ЖурналПеремен(Текст);
КонецФункции

#КонецОбласти
