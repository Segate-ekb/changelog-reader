#Использовать semver

// Журнал изменений в формате Keep a Changelog: релизы, блок «Не выпущено» и выборки
// по версиям. Сравнение версий семантическое, поэтому «1.10.0» старше «1.2.0».

Перем Релизы_;
Перем Неизданное_;

#Область ПрограммныйИнтерфейс

// Релизы журнала, от самого свежего к самому старому. Блоки, версию которых semver
// не принял, релизами не считаются и сюда не попадают.
//
// Возвращаемое значение:
//  Массив из РелизЖурнала
//
Функция Релизы() Экспорт
	Копия = Новый Массив();
	Для Каждого Релиз_ Из Релизы_ Цикл
		Копия.Добавить(Релиз_);
	КонецЦикла;
	Возврат Копия;
КонецФункции

// Версии релизов в том же порядке, что и Релизы().
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ВерсииРелизов() Экспорт
	Результат = Новый Массив();
	Для Каждого Релиз_ Из Релизы_ Цикл
		Результат.Добавить(Релиз_.Версия());
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Самый свежий релиз журнала.
//
// Возвращаемое значение:
//  РелизЖурнала, Неопределено - Неопределено, если релизов нет.
//
Функция ПоследнийРелиз() Экспорт
	Возврат ?(Релизы_.Количество() = 0, Неопределено, Релизы_[0]);
КонецФункции

// Релиз по версии. Сравнение семантическое: «1.0» находит релиз «1.0.0».
//
// Параметры:
//  Версия - Строка - искомая версия, приставка «v» допускается.
//
// Возвращаемое значение:
//  РелизЖурнала, Неопределено - Неопределено, если такой версии в журнале нет.
//
Функция Релиз(Знач Версия) Экспорт

	Искомая = БезПриставки(Версия);
	Если НЕ ЗначениеЗаполнено(Искомая) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Релиз_ Из Релизы_ Цикл
		Если Равны(Релиз_.Версия(), Искомая) Тогда
			Возврат Релиз_;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Описан ли релиз этой версии в журнале.
//
// Параметры:
//  Версия - Строка - искомая версия.
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьВерсия(Знач Версия) Экспорт
	Возврат Релиз(Версия) <> Неопределено;
КонецФункции

// Релизы, попадающие в диапазон semver, в том же порядке, что и Релизы().
//
// Параметры:
//  Диапазон - Строка - диапазон semver: «^1.0», «>=1.2.0 <2.0.0», «1.x».
//
// Возвращаемое значение:
//  Массив из РелизЖурнала - пустой массив, если не подошёл ни один релиз.
//
Функция РелизыВДиапазоне(Знач Диапазон) Экспорт

	Результат = Новый Массив();
	Значение = СокрЛП(Строка(?(Диапазон = Неопределено, "", Диапазон)));
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Релиз_ Из Релизы_ Цикл
		Попытка
			Подходит = Версии.ВерсияВДиапазоне(Релиз_.Версия(), Значение);
		Исключение
			Подходит = Ложь;
		КонецПопытки;
		Если Подходит Тогда
			Результат.Добавить(Релиз_);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Блок «Не выпущено» / «Unreleased».
//
// Возвращаемое значение:
//  РелизЖурнала, Неопределено - Неопределено, если такого блока в журнале нет.
//
Функция Неизданное() Экспорт
	Возврат Неизданное_;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Разобрать(Знач Текст)

	Значение = СтрЗаменить(Строка(?(Текст = Неопределено, "", Текст)), Символы.ВК, "");
	Заголовок = "";
	Тело = Новый Массив();

	Для Каждого Строка_ Из СтрРазделить(Значение, Символы.ПС, Истина) Цикл
		Если НЕ ЭтоЗаголовокРелиза(Строка_) Тогда
			Тело.Добавить(Строка_);
			Продолжить;
		КонецЕсли;
		ПринятьБлок(Заголовок, Тело);
		Заголовок = СокрЛП(Строка_);
		Тело = Новый Массив();
	КонецЦикла;

	ПринятьБлок(Заголовок, Тело);
	Упорядочить();

КонецПроцедуры

// Релиз открывает ровно «## », но не «### »: третий уровень — это разделы внутри релиза.
Функция ЭтоЗаголовокРелиза(Знач Строка_)
	Значение = СокрЛП(Строка_);
	Возврат СтрНачинаетсяС(Значение, "## ") ИЛИ Значение = "##";
КонецФункции

Процедура ПринятьБлок(Знач Заголовок, Знач Тело)

	Если НЕ ЗначениеЗаполнено(Заголовок) Тогда
		Возврат;
	КонецЕсли;

	Релиз_ = Новый РелизЖурнала(Заголовок, СтрСоединить(Тело, Символы.ПС));

	Если Релиз_.ЭтоНеизданное() Тогда
		// первый блок выигрывает: второй «Не выпущено» — это ошибка журнала, и молча
		// подменять им первый значило бы отдавать заметки не того блока
		Если Неизданное_ = Неопределено Тогда
			Неизданное_ = Релиз_;
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Релиз_.Версия()) Тогда
		Релизы_.Добавить(Релиз_);
	КонецЕсли;

КонецПроцедуры

// Порядок задаёт semver, а не порядок строк в файле и не сравнение строк: «1.10.0»
// старше «1.2.0», хотя как строка меньше.
Процедура Упорядочить()

	Для Индекс = 1 По Релизы_.ВГраница() Цикл
		Текущий = Релизы_[Индекс];
		Позиция = Индекс - 1;
		Пока Позиция >= 0 И Старше(Текущий.Версия(), Релизы_[Позиция].Версия()) Цикл
			Релизы_[Позиция + 1] = Релизы_[Позиция];
			Позиция = Позиция - 1;
		КонецЦикла;
		Релизы_[Позиция + 1] = Текущий;
	КонецЦикла;

КонецПроцедуры

Функция Старше(Знач Первая, Знач Вторая)
	Попытка
		Возврат Версии.ВерсияБольше(Первая, Вторая);
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция Равны(Знач Первая, Знач Вторая)
	Попытка
		Возврат Версии.ВерсииРавны(Первая, Вторая);
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция БезПриставки(Знач Версия)
	Значение = СокрЛП(Строка(?(Версия = Неопределено, "", Версия)));
	Возврат ?(СтрНачинаетсяС(НРег(Значение), "v"), Сред(Значение, 2), Значение);
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач Текст = "") Экспорт

	Релизы_ = Новый Массив();
	Неизданное_ = Неопределено;
	Разобрать(Текст);

КонецПроцедуры
