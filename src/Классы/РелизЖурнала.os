#Использовать semver
#Использовать strings

// Один блок журнала изменений: заголовок «## [1.2.0] - 2026-02-01» и его тело.
// Заголовок даёт версию и дату, тело — разделы («### Добавлено») и пункты списка.

Перем Версия_;
Перем Дата_;
Перем Заголовок_;
Перем Неизданное_;
Перем ИменаРазделов_;
Перем Разделы_;
Перем Текст_;

#Область ПрограммныйИнтерфейс

// Версия релиза так, как она написана в журнале, без приставки «v».
//
// Возвращаемое значение:
//  Строка - «1.2.0»; "" — блок версии не несёт (в том числе «Не выпущено»).
//
Функция Версия() Экспорт
	Возврат Версия_;
КонецФункции

// Дата релиза из заголовка.
//
// Возвращаемое значение:
//  Дата - дата релиза; пустая дата — в заголовке её нет либо она не разобрана.
//
Функция ДатаРелиза() Экспорт
	Возврат Дата_;
КонецФункции

// Текст заголовка без решёток.
//
// Возвращаемое значение:
//  Строка - «[1.2.0] - 2026-02-01».
//
Функция Заголовок() Экспорт
	Возврат Заголовок_;
КонецФункции

// Блок «Не выпущено» / «Unreleased» — накопленные, но не выпущенные изменения.
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоНеизданное() Экспорт
	Возврат Неизданное_;
КонецФункции

// Имена разделов в порядке появления в журнале.
//
// Возвращаемое значение:
//  Массив из Строка - «Добавлено», «Исправлено»; "" — пункты до первого «###».
//
Функция ИменаРазделов() Экспорт
	Копия = Новый Массив();
	Для Каждого Имя Из ИменаРазделов_ Цикл
		Копия.Добавить(Имя);
	КонецЦикла;
	Возврат Копия;
КонецФункции

// Есть ли в релизе раздел с таким именем. Регистр имени не значим.
//
// Параметры:
//  ИмяРаздела - Строка - имя раздела.
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьРаздел(Знач ИмяРаздела) Экспорт
	Возврат Разделы_.Получить(Ключ(ИмяРаздела)) <> Неопределено;
КонецФункции

// Пункты списка релиза без маркеров.
//
// Параметры:
//  ИмяРаздела - Строка - имя раздела; "" — все пункты релиза в порядке появления
//               (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Массив из Строка - пункты; пустой массив, если раздела нет.
//
Функция Пункты(Знач ИмяРаздела = "") Экспорт

	Результат = Новый Массив();

	Если НЕ ЗначениеЗаполнено(СокрЛП(Строка(ИмяРаздела))) Тогда
		Для Каждого Имя Из ИменаРазделов_ Цикл
			Для Каждого Пункт Из Разделы_[Ключ(Имя)] Цикл
				Результат.Добавить(Пункт);
			КонецЦикла;
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Найденные = Разделы_.Получить(Ключ(ИмяРаздела));
	Если Найденные = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Пункт Из Найденные Цикл
		Результат.Добавить(Пункт);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Разделы релиза целиком.
//
// Возвращаемое значение:
//  Соответствие - имя раздела в нижнем регистре -> Массив из Строка.
//
Функция Разделы() Экспорт
	Копия = Новый Соответствие();
	Для Каждого КиЗ Из Разделы_ Цикл
		Пункты_ = Новый Массив();
		Для Каждого Пункт Из КиЗ.Значение Цикл
			Пункты_.Добавить(Пункт);
		КонецЦикла;
		Копия.Вставить(КиЗ.Ключ, Пункты_);
	КонецЦикла;
	Возврат Копия;
КонецФункции

// Тело релиза как оно написано в журнале — готовые заметки к релизу.
//
// Возвращаемое значение:
//  Строка - markdown без строки заголовка и без пустых строк по краям.
//
Функция Текст() Экспорт
	Возврат Текст_;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура РазобратьЗаголовок(Знач СтрокаЗаголовка)

	Значение = СокрЛП(Строка(?(СтрокаЗаголовка = Неопределено, "", СтрокаЗаголовка)));
	Пока СтрНачинаетсяС(Значение, "#") Цикл
		Значение = СокрЛ(Сред(Значение, 2));
	КонецЦикла;

	Заголовок_ = Значение;
	Токен = Токен(Значение);
	Хвост = СокрЛП(Сред(Значение, СтрДлина(Токен) + 1));

	Неизданное_ = ЭтоСловоНеизданного(БезСкобок(Токен));
	Версия_ = ?(Неизданное_, "", ВерсияТокена(БезСкобок(Токен)));
	Дата_ = ДатаХвоста(Хвост);

КонецПроцедуры

// Токеном считается либо значение в квадратных скобках, либо первое слово: обе формы
// заголовка встречаются в реальных журналах.
Функция Токен(Знач Значение)

	Если СтрНачинаетсяС(Значение, "[") Тогда
		Закрывающая = СтрНайти(Значение, "]");
		Возврат ?(Закрывающая = 0, Значение, Лев(Значение, Закрывающая));
	КонецЕсли;

	Пробел = СтрНайти(Значение, " ");
	Возврат ?(Пробел = 0, Значение, Лев(Значение, Пробел - 1));

КонецФункции

Функция БезСкобок(Знач Токен)
	Значение = СокрЛП(Строка(Токен));
	Если СтрНачинаетсяС(Значение, "[") Тогда
		Значение = Сред(Значение, 2);
	КонецЕсли;
	Если СтрЗаканчиваетсяНа(Значение, "]") Тогда
		Значение = Лев(Значение, СтрДлина(Значение) - 1);
	КонецЕсли;
	Возврат СокрЛП(Значение);
КонецФункции

// Версия отдаётся только тогда, когда её принял semver: заголовок «[следующий]» — это
// не релиз, и молча считать его версией значило бы пустить мусор в выборки журнала.
Функция ВерсияТокена(Знач Токен)

	Значение = СокрЛП(Строка(Токен));
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Если СтрНачинаетсяС(НРег(Значение), "v") Тогда
		Значение = Сред(Значение, 2);
	КонецЕсли;

	Попытка
		Разобранная = Версии.ВерсияИзСтроки(Значение);
	Исключение
		Возврат "";
	КонецПопытки;

	Возврат ?(Разобранная = Неопределено ИЛИ Разобранная.Ошибка(), "", Значение);

КонецФункции

// Дата отделяется от версии тире любого начертания; «2026-02-01» и «01.02.2026» читает
// СтроковыеФункции, нераспознанное остаётся пустой датой.
Функция ДатаХвоста(Знач Хвост)

	Значение = СокрЛП(Строка(Хвост));
	Для Каждого Тире Из СтрРазделить("-,—,–,~,:", ",") Цикл
		Если СтрНачинаетсяС(Значение, Тире) Тогда
			Значение = СокрЛП(Сред(Значение, СтрДлина(Тире) + 1));
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Части = СтроковыеФункции.РазложитьСтрокуВМассивПодстрок(Значение, " ", Истина, Истина);
	Если Части.Количество() = 0 Тогда
		Возврат '00010101';
	КонецЕсли;

	Попытка
		Возврат СтроковыеФункции.СтрокаВДату(Части[0]);
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции

Функция ЭтоСловоНеизданного(Знач Токен)
	Слово = НРег(СокрЛП(Строка(Токен)));
	Возврат Слово = "unreleased" ИЛИ Слово = "не выпущено" ИЛИ Слово = "неизданное";
КонецФункции

Процедура РазобратьТело(Знач ТекстТела)

	Значение = СтрЗаменить(Строка(?(ТекстТела = Неопределено, "", ТекстТела)), Символы.ВК, "");
	Текст_ = ОбрезатьПустыеСтроки(Значение);

	ТекущийРаздел = "";
	Для Каждого Строка_ Из СтрРазделить(Значение, Символы.ПС, Истина) Цикл

		Обрезанная = СокрЛП(Строка_);

		Если СтрНачинаетсяС(Обрезанная, "###") Тогда
			ТекущийРаздел = ИмяРаздела(Обрезанная);
			ЗавестиРаздел(ТекущийРаздел);
			Продолжить;
		КонецЕсли;

		Пункт = ПунктСписка(Обрезанная);
		Если ЗначениеЗаполнено(Пункт) Тогда
			ЗавестиРаздел(ТекущийРаздел);
			Разделы_[Ключ(ТекущийРаздел)].Добавить(Пункт);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция ИмяРаздела(Знач Строка_)
	Значение = Строка_;
	Пока СтрНачинаетсяС(Значение, "#") Цикл
		Значение = Сред(Значение, 2);
	КонецЦикла;
	Возврат СокрЛП(Значение);
КонецФункции

// Пунктом считается строка списка markdown; вложенные пункты сохраняют свой отступ
// в тексте релиза, но в плоский список пунктов раздела не поднимаются.
Функция ПунктСписка(Знач Строка_)

	Для Каждого Маркер Из СтрРазделить("- ,* ,+ ", ",") Цикл
		Если СтрНачинаетсяС(Строка_, Маркер) Тогда
			Возврат СокрЛП(Сред(Строка_, СтрДлина(Маркер) + 1));
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Процедура ЗавестиРаздел(Знач Имя)
	Если Разделы_.Получить(Ключ(Имя)) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Разделы_.Вставить(Ключ(Имя), Новый Массив());
	ИменаРазделов_.Добавить(Имя);
КонецПроцедуры

Функция Ключ(Знач Имя)
	Возврат НРег(СокрЛП(Строка(?(Имя = Неопределено, "", Имя))));
КонецФункции

Функция ОбрезатьПустыеСтроки(Знач Значение)

	Строки = СтрРазделить(Значение, Символы.ПС, Истина);
	Первая = 0;
	Пока Первая <= Строки.ВГраница() И НЕ ЗначениеЗаполнено(СокрЛП(Строки[Первая])) Цикл
		Первая = Первая + 1;
	КонецЦикла;

	Последняя = Строки.ВГраница();
	Пока Последняя >= Первая И НЕ ЗначениеЗаполнено(СокрЛП(Строки[Последняя])) Цикл
		Последняя = Последняя - 1;
	КонецЦикла;

	Отобранные = Новый Массив();
	Для Индекс = Первая По Последняя Цикл
		Отобранные.Добавить(Строки[Индекс]);
	КонецЦикла;
	Возврат СтрСоединить(Отобранные, Символы.ПС);

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач СтрокаЗаголовка, Знач ТекстТела = "") Экспорт

	ИменаРазделов_ = Новый Массив();
	Разделы_ = Новый Соответствие();

	РазобратьЗаголовок(СтрокаЗаголовка);
	РазобратьТело(ТекстТела);

КонецПроцедуры
